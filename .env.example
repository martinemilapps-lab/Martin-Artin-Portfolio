# TURSO LIBSQL CLOUD DATABASE CONFIGURATION (SERVER-SIDE ONLY)
# Never prefix with VITE_ to prevent client-side exposure.
TURSO_DATABASE_URL=https://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_server_auth_token_here

# ADMINISTRATOR BOOTSTRAP CREDENTIALS (SERVER-SIDE ONLY)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_secure_admin_password_here

# SESSION SIGNING SECRET (SERVER-SIDE ONLY)
# Cryptographically strong 64+ char random hex string
SESSION_SECRET=your_high_entropy_session_secret_here
